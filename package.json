{
  "name": "markdown-studio",
  "version": "1.0.0",
  "description": "Estúdio de Markdown: visualizador em tela cheia e conversor para PDF com controle tipográfico.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node scripts/check-integrity.js && node scripts/test-format.js && node scripts/test-render.js && node scripts/test-matrix.js && node scripts/test-image-codecs.js && node scripts/test-html-pdf.js && node scripts/test-salas.js",
    "test:format": "node scripts/test-format.js",
    "test:render": "node scripts/test-render.js",
    "test:pdf": "node scripts/test-matrix.js",
    "test:images": "node scripts/test-image-codecs.js",
    "test:html-pdf": "node scripts/test-html-pdf.js",
    "test:salas": "node scripts/test-salas.js",
    "test:images:browser": "node scripts/probe-images.js",
    "test:api": "node scripts/test-api.js",
    "test:browser": "node scripts/probe-browser.js",
    "check": "node scripts/check-integrity.js",
    "smoke": "node scripts/smoke-pdf.js"
  },
  "keywords": [
    "markdown",
    "pdf",
    "editor",
    "express"
  ],
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "express": "^5.2.1",
    "highlight.js": "^11.12.0",
    "markdown-it": "^15.0.2",
    "pagedjs": "^0.4.3",
    "pdfkit": "^0.20.2"
  }
}