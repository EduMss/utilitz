# ------------------------------------------------------------------
# Utilitz Studio
# ------------------------------------------------------------------
# Copie este arquivo para `.env` e ajuste o que precisar. O `.env` é lido na
# subida do servidor e NÃO sobrescreve variáveis já definidas no ambiente
# (Docker, shell, CI), então configurar de fora continua ganhando.

# Gerador de PDF:
#   false  -> usa o gerador atual (PDFKit), igual sempre foi
#   true   -> renderiza o HTML com o Chrome/Chromium (headless) e imprime o PDF
# Qualquer valor diferente de false/0/off liga o modo Chrome. Sem um navegador
# instalado, o servidor volta sozinho para o PDFKit.
USER_CHROME=false

# Onde está o Chrome/Chromium/Edge. Aceita o caminho do executável ou a pasta
# que o contém. Em branco, o servidor procura nos caminhos comuns do sistema.
#   Windows: C:\Program Files\Google\Chrome\Application
#   macOS:   /Applications/Google Chrome.app/Contents/MacOS
#   Linux:   /usr/bin
DIR_CHROME=

# ------------------------------------------------------------------
# Salas compartilhadas (/notas e /drive)
# ------------------------------------------------------------------
# Quanto tempo uma sala de notas vive depois da criação ou da última edição.
# Entrar na sala e só olhar NÃO reinicia o relógio: quando o prazo acaba, a
# sala some e as abas abertas trocam para o painel de expirada. Digitar de
# novo é que recomeça a contagem.
NOTES_TTL_MIN=10

# Quanto tempo cada ARQUIVO do drive vive depois de terminar o envio. O
# relógio do arquivo só começa quando o upload fecha, e um download em
# andamento segura a exclusão até a pessoa terminar de baixar.
DRIVE_TTL_MIN=10

# Limite de tamanho por arquivo enviado ao drive (megabytes). Vale também
# como leitura do servidor: acima disso a resposta vem 413 sem nem começar
# a gravar. Os valores vêm do ambiente se já estiverem definidos (Docker,
# shell, CI), e qualquer número igual ou menor cai no padrão.
DRIVE_MAX_MB=25
